# ====================================================
# VIGIL Environment Configuration Template
# ====================================================

PORT=5000
NODE_ENV=development

# ----------------------------------------------------
# 1. Google Gemini AI API Key (Backend)
# Used for conversational AI check-ins & Sit-Rep generation
# Get your key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------
GEMINI_API_KEY=your_gemini_key

# ----------------------------------------------------
# 2. Google Maps JavaScript API Key (Frontend Vite)
# Used for interactive maps, satellite tiles & navigation polyline
# Get your key at: https://console.cloud.google.com/google/maps-apis
# ----------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=your_maps_key

# Database & Session Configuration
USE_LOCAL_DB=true
JWT_SECRET=vigil_bugbusters_secret_key_2026

# Default Coordinates
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946
